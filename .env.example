# =============================================================================
# AI Lead Intelligence Engine - environment template
# Copy to .env (git-ignored) and fill in ONLY what the current phase needs.
# NEVER commit a real value. Every key below is optional in Phase 1.
# Setup/rotation instructions per provider: docs/providers/PROVIDER_SETUP.md
# =============================================================================

# --- Application ---------------------------------------------------------------
APP_NAME=ai-lead-intelligence
# development | test | staging | production
APP_ENV=development
DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
API_HOST=127.0.0.1
API_PORT=8000

# --- Database (PostgreSQL system of record) -----------------------------------
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME   (required in staging/production)
DATABASE_URL=
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# --- Provider safety switches --------------------------------------------------
# mock = offline fakes (default, Phase 1). live = real adapters (non-operational in Phase 1).
PROVIDER_MODE=mock
# Master kill-switch for anything that spends credits (Apify, Firecrawl, enrichment-kit, Hunter, Apollo).
ALLOW_PAID_PROVIDER_CALLS=false

# --- LLM / reasoning: OpenAI (Phase 10, ACTIVE) --------------------------------
# openai = default. ai_router = the DEPRECATED Techno-AI-Router (explicit opt-in only).
REASONING_PROVIDER=openai
# --- Claude (REASONING_PROVIDER=anthropic): lead analysis, AI review, name extraction ---
# A Claude API key starts with "sk-ant-" (Claude Console > API keys).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_TIMEOUT_SECONDS=180
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_REFUSAL_FALLBACK=true
ANTHROPIC_PRICE_INPUT_PER_1M_USD=
ANTHROPIC_PRICE_OUTPUT_PER_1M_USD=
ANTHROPIC_MAX_TOKENS_PER_RUN=200000
ANTHROPIC_MAX_ESTIMATED_COST_USD_PER_RUN=1.00
ANTHROPIC_MAX_ESTIMATED_COST_USD_PER_MONTH=15.00
# Let the reasoning model name the companies in social posts the patterns could not read.
DISCOVERY_LLM_EXTRACTION=false
# Secret. Put the value ONLY in your local .env / secret store (docs/OPENAI_PROVIDER_NOTES.md).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# empty = the SDK's default endpoint
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_MAX_TOKENS=2500
# empty = model default; or none|minimal|low|medium|high (reasoning models only)
OPENAI_REASONING_EFFORT=
# USD per 1M tokens; empty = built-in table for known models (unknown model + empty = refuse)
OPENAI_PRICE_INPUT_PER_1M_USD=
OPENAI_PRICE_OUTPUT_PER_1M_USD=
# AI budgets (estimated cost), checked before every call
OPENAI_MAX_TOKENS_PER_RUN=60000
OPENAI_MAX_ESTIMATED_COST_USD_PER_RUN=0.25
OPENAI_MAX_ESTIMATED_COST_USD_PER_MONTH=5.00

# --- DEPRECATED: Techno-AI-Router (only with REASONING_PROVIDER=ai_router) ------
# Single AI boundary (no direct OpenAI/Anthropic/OpenRouter keys). Discovery is open; chat
# needs a tair_... key - put it ONLY in your local .env (see docs/TECHNO_AI_ROUTER_SETUP_GUIDE.md).
# e.g. AI_ROUTER_BASE_URL=https://techno-ai-router.vercel.app
AI_ROUTER_BASE_URL=
AI_ROUTER_API_KEY=
# empty = the first enabled model within the price ceiling (checked live against /v1/models)
AI_ROUTER_DEFAULT_MODEL=
AI_ROUTER_GATEWAY=openrouter
# comma list of gateway/model entries, e.g. openrouter/openai/gpt-oss-20b:free
AI_ROUTER_FALLBACK_MODELS=
AI_ROUTER_TIMEOUT_SECONDS=60
AI_ROUTER_MAX_RETRIES=1
AI_ROUTER_MAX_TOKENS=1500
AI_ROUTER_TEMPERATURE=0.2
# USD per 1M tokens (in and out); 0 = free ($0 / $0) models only
AI_ROUTER_MAX_PRICE_PER_1M_TOKENS_USD=0
# Phase 7 analysis budgets / eligibility
ANALYSIS_MAX_PER_RUN=5
ANALYSIS_MAX_TOKENS_PER_RUN=30000
ANALYSIS_MAX_COST_USD_PER_RUN=0
ANALYSIS_MAX_COST_USD_PER_MONTH=0
ANALYSIS_REQUIRE_VERIFIED_CONTACT=true
ANALYSIS_MIN_CONFIDENCE=0.0

# --- Discovery: Apify (Phase 2) ------------------------------------------------
APIFY_TOKEN=
# Backup keys, comma-separated: used automatically when a key is rejected or out of credits.
APIFY_TOKEN_BACKUPS=
# Actor used for discovery (official Apify Google Search Results Scraper).
APIFY_DISCOVERY_ACTOR_ID=apify/google-search-scraper
# Hard per-run ceilings. A request can ask for less, never more.
# 1 item = 1 Google results page (~10 organic results).
APIFY_MAX_ITEMS_PER_RUN=1
# Hard cap Apify enforces per run (max_total_charge_usd). Apify's minimum is 0.50.
APIFY_MAX_CHARGE_USD_PER_RUN=0.50
# Tight budget guard: runs whose worst-case estimated cost exceeds this are blocked before
# Apify is called (1 Google results page ~ 0.0055 USD on the FREE tier).
APIFY_MAX_ESTIMATED_COST_USD_PER_RUN=0.05
APIFY_RUN_TIMEOUT_SECONDS=180

# --- Website intelligence: Firecrawl (Phase 3) ---------------------------------
FIRECRAWL_API_KEY=
FIRECRAWL_API_KEY_BACKUPS=
# Only for self-hosted Firecrawl; leave empty for the hosted API (https://api.firecrawl.dev/v2).
FIRECRAWL_BASE_URL=
FIRECRAWL_TIMEOUT_SECONDS=60
# Budgets (hard ceilings; requests can only lower them).
# Firecrawl credits: search 2 per 10 results, map 1, scrape 1 per page.
WEBSITE_MAX_PAGES_PER_COMPANY=8
FIRECRAWL_MAX_CREDITS_PER_COMPANY=15
FIRECRAWL_MAX_CREDITS_PER_RUN=50
# Domain resolution via Firecrawl Search.
DOMAIN_SEARCH_RESULT_LIMIT=5
DOMAIN_MIN_CONFIDENCE=0.7

# --- Fallback crawler: Crawl4AI (Phase 3, local Docker server, no paid key) ----
# Official image unclecode/crawl4ai:0.9.4 bound to 127.0.0.1 (see PROVIDER_SETUP.md).
CRAWL4AI_BASE_URL=
# Token that authenticates us to OUR local container (generate locally; never commit).
CRAWL4AI_API_TOKEN=
CRAWL4AI_TIMEOUT_SECONDS=90

# --- Social/web signals: Agent-Reach (Phase 4, public + unauthenticated only) ---
# Allowed values (subset, comma-separated): news_rss,youtube. LinkedIn/Instagram/X/Reddit/
# Facebook and any cookie/login route are NOT representable (enforced in code).
AGENT_REACH_CHANNELS=news_rss,youtube
# yt-dlp installed by Agent-Reach as an isolated uv tool (see PROVIDER_SETUP.md).
AGENT_REACH_YTDLP_PATH=yt-dlp
AGENT_REACH_TIMEOUT_SECONDS=30
# Research budget per VERIFIED company (flags can only lower these).
SIGNAL_MAX_QUERIES_PER_COMPANY=5
SIGNAL_MAX_ITEMS_PER_COMPANY=20

# --- Qualification gate: Laya (Phase 5, no API key) ----------------------------
# Self-hosted `laya-serve` sidecar (isolated uv tool). Loopback addresses only.
# e.g. LAYA_ENDPOINT_URL=http://127.0.0.1:8765 ; LAYA_API_KEY only if the sidecar sets one.
LAYA_MODEL_PATH=
LAYA_ENDPOINT_URL=
LAYA_API_KEY=
LAYA_CHECKPOINT=typed-decisions
LAYA_TIMEOUT_SECONDS=30
# Decision thresholds on Laya's bounded P(true) answers (reject < qualify).
LAYA_QUALIFY_THRESHOLD=0.7
LAYA_REJECT_THRESHOLD=0.3
# Optional LLM review of REVIEW cases only (AI Router; live adapter is a disabled contract).
LLM_REVIEW_ENABLED=false
LLM_REVIEW_MIN_CONFIDENCE=0.75

# --- Enrichment (Phase 6) ------------------------------------------------------
# Project-owned Node sidecar (sidecars/enrichment-kit) on 127.0.0.1 around a pinned
# enrichment-kit build. The SIDECAR reads HUNTER_API_KEY / APOLLO_API_KEY /
# ENRICHMENT_KIT_API_TOKEN / ENRICHMENT_KIT_PORT from this file; the app only checks presence.
# e.g. ENRICHMENT_KIT_BASE_URL=http://127.0.0.1:8787 (loopback only)
ENRICHMENT_KIT_BASE_URL=
ENRICHMENT_KIT_API_TOKEN=
ENRICHMENT_KIT_PORT=8787
ENRICHMENT_KIT_TIMEOUT_SECONDS=45
ENRICHMENT_KIT_MAX_PROVIDER_CALLS=50
HUNTER_API_KEY=
HUNTER_API_KEY_BACKUPS=
APOLLO_API_KEY=
APOLLO_API_KEY_BACKUPS=
# Waterfall thresholds (min accepted / early exit / final "verified" confidence)
ENRICHMENT_MIN_CONFIDENCE=0.5
ENRICHMENT_EARLY_EXIT_CONFIDENCE=0.85
ENRICHMENT_ACCEPT_CONFIDENCE=0.7
ENRICHMENT_CACHE_TTL_DAYS=30
ENRICHMENT_VERIFICATION_TTL_DAYS=30
ENRICHMENT_ROLE_PRIORITY=founder,co-founder,ceo,chief executive,managing director,cto,owner,coo,president
ENRICHMENT_MAX_PERSONS_PER_COMPANY=1
# Decision-maker discovery when the company's own pages name nobody: none | hunter
ENRICHMENT_PEOPLE_SEARCH=none
# Budgets (checked BEFORE every paid call; a budget hit stops safely)
ENRICHMENT_MAX_ATTEMPTS_PER_LEAD=4
ENRICHMENT_MAX_SIDECAR_CALLS_PER_RUN=10
# No founder named on the company website / by the people search: look the founder up in
# public web-search results (names + roles in result titles, no page fetched), then find the
# email. One search per company (Firecrawl search = 2 credits); own per-run budget.
ENRICHMENT_WEB_SEARCH=true
ENRICHMENT_MAX_WEB_SEARCHES_PER_RUN=5
# Phone capability - OFF by default. true = a number the provider already returns with the
# email-finder result is kept (no extra credit). Apollo's paid mobile reveal is NEVER requested.
# Own budget: how many contacts per run may be asked for a phone. Blank phone is normal.
ENRICHMENT_PHONE_ENABLED=false
ENRICHMENT_MAX_PHONE_LOOKUPS_PER_RUN=5
ENRICHMENT_MAX_HUNTER_CREDITS_PER_RUN=5
ENRICHMENT_MAX_APOLLO_CREDITS_PER_RUN=3
ENRICHMENT_MAX_HUNTER_CREDITS_PER_MONTH=50
ENRICHMENT_MAX_APOLLO_CREDITS_PER_MONTH=20
# USD per credit (plan-dependent estimates, used for reporting + USD budgets)
ENRICHMENT_HUNTER_CREDIT_USD=0.03
ENRICHMENT_APOLLO_CREDIT_USD=0.05
ENRICHMENT_MAX_COST_USD_PER_RUN=0.50
ENRICHMENT_MAX_COST_USD_PER_MONTH=5.00

# --- Source Actor Registry (Phase 6) ---------------------------------------------
# Only declared, APPROVED, unauthenticated sources with a parser can run; this enables them.
# Runnable: funding_news, startup_news (Google Search), linkedin_posts, linkedin_jobs, x_posts
# (public Actors, no cookies). Anything that needs a login or cookie stays blocked.
DISCOVERY_SOURCES_ENABLED=funding_news
# ICP query sets (";"-separated Google queries, one results page each). A pipeline discovery
# stage sends as many of them as APIFY_MAX_ITEMS_PER_RUN allows (default 1) and rotates through
# the set from run to run. Worst-case cost per source = $0.001 + $0.0045 x queries, checked
# against APIFY_MAX_ESTIMATED_COST_USD_PER_RUN before Apify is called.
DISCOVERY_QUERIES=startup raises seed funding crore India;Indian startup raises pre-seed round lakh;startup bags angel funding Rs crore;D2C brand raises seed funding India;SaaS startup secures pre-seed funding India;startup raises bridge round crore India
DISCOVERY_NEWS_QUERIES=Indian startup launches new platform;India startup expands to new cities;bootstrapped Indian startup hiring team
# Social / job-platform sources: linkedin_posts, linkedin_jobs, x_posts, reddit. Public Apify Actors,
# NO login or cookies are ever sent. Off until listed in DISCOVERY_SOURCES_ENABLED, e.g.
#   DISCOVERY_SOURCES_ENABLED=funding_news,startup_news,linkedin_posts,linkedin_jobs,x_posts,reddit
# One query per source per run (rotating). Cost per source per run:
#   linkedin_posts / linkedin_jobs  ~ $0.002 x items     x_posts ~ $0.0004 x items
DISCOVERY_LINKEDIN_QUERIES=startup raised seed round India;raised pre-seed funding India startup;angel round crore startup India
DISCOVERY_LINKEDIN_JOBS_QUERIES=founding engineer startup;first sales hire startup;founder's office
DISCOVERY_X_QUERIES=startup raises seed funding India;raises pre-seed round crore;bags angel funding crore
# Reddit entries are "<subreddit>:<keywords>" (one subreddit search per run, ~$0.0015 x items).
DISCOVERY_REDDIT_QUERIES=StartUpIndia:raised seed funding;indianstartups:raised funding;IndiaBusiness:startup raises crore
DISCOVERY_SOCIAL_MAX_ITEMS_PER_RUN=10
# Google date filter (m3 = past 3 months = the 90-day trigger window). Empty = no filter.
DISCOVERY_QUICK_DATE_RANGE=m3

# --- Business rules / ICP ------------------------------------------------------
# Funding cap per round in INR (5 Cr = 50,000,000)
FUNDING_CAP_INR=50000000
MONTHLY_LEAD_TARGET_MIN=25
MONTHLY_LEAD_TARGET_MAX=30
# Phase 5 hard ICP rules (see docs/phases/QUALIFICATION_POLICY.md)
ICP_COUNTRY_CODE=IN
ICP_COUNTRY_TLDS=in
# Optional FX for USD-reported rounds; empty = USD amounts are "unknown" (-> REVIEW)
ICP_USD_TO_INR_RATE=
ICP_FUNDING_WINDOW_DAYS=90
ICP_INTENT_WINDOW_DAYS=90
# intent-path company with a recent round ABOVE the cap: ignore | review | reject
ICP_OVER_CAP_FUNDING_POLICY=review
ICP_MIN_SIGNAL_CONFIDENCE=0.6
# hard rules pass but Laya is neither clearly positive nor negative: qualify | review
# (qualify = hard rules decide, Laya only vetoes; review = a human decides each case)
ICP_LAYA_AMBIGUOUS_POLICY=qualify
# Event clustering (duplicate publisher coverage counts once)
CLUSTER_TITLE_SIMILARITY=0.5
CLUSTER_WINDOW_DAYS=7

# --- Pipeline orchestration (Phase 9) -----------------------------------------
# Stages per run, fixed order. Discovery spends Apify credit, so it is opt-in: add "discovery"
# in front here, or pass --stages all to scripts/run_pipeline.py.
PIPELINE_STAGES=prescreen,website,signals,qualification,enrichment,analysis,export
# Team members who can own leads: the owner chosen for a run gets every lead that run produces.
LEAD_OWNERS=Asha,Ravi,Meera
# Pre-screen = free check on discovery data (name / funding cap / late-stage rules + optional
# local Laya veto) BEFORE any website credit is spent. PRESCREEN_REQUIRED=true: the website
# stage only scrapes companies with a green (scrape) verdict.
PRESCREEN_REQUIRED=true
PRESCREEN_USE_LAYA=true
# Deprecated: comma list that replaces DISCOVERY_QUERIES for funding_news. Leave empty.
PIPELINE_DISCOVERY_KEYWORDS=
# Companies per stage when no --limit is given; an explicit --limit is honoured up to
# PIPELINE_MAX_COMPANY_LIMIT and refused (never silently reduced) beyond it.
PIPELINE_COMPANY_LIMIT=5
PIPELINE_MAX_COMPANY_LIMIT=25
PIPELINE_MAX_ESTIMATED_COST_USD_PER_RUN=1.00
PIPELINE_STALE_AFTER_MINUTES=60
# "Leads wanted" runs repeat the stages (next searches, next companies) until that many new
# sheet rows exist: at most PIPELINE_MAX_ROUNDS rounds, inside the cost cap above.
PIPELINE_MAX_ROUNDS=5
# Speed: discovery sources / company websites worked on at the same time (1 = one by one).
PIPELINE_PARALLEL_SOURCES=4
PIPELINE_PARALLEL_COMPANIES=3
PIPELINE_MAX_TARGET_LEADS=10
# Scheduler: minutes between automatic runs; 0 = off
PIPELINE_SCHEDULE_INTERVAL_MINUTES=0

# --- Private service network (Phase 10, container deployments only) -----------
# Service names on the PRIVATE Docker network that count as local (Compose sets this itself).
INTERNAL_SERVICE_HOSTS=
# Replaces only the host of DATABASE_URL (Compose sets "postgres"); empty = unchanged.
DATABASE_HOST_OVERRIDE=
# Use another database on the same server, e.g. lead_intel_demo (labelled demo data)
DATABASE_NAME_OVERRIDE=

# --- API hardening (Phase 10) -------------------------------------------------
# Secret operator token for /api/v1 (mandatory when APP_ENV=staging/production). Value only in .env.
OPERATOR_API_TOKEN=
# Comma list of exact origins allowed to call the API from a browser; empty = same-origin only
CORS_ALLOWED_ORIGINS=
MAX_REQUEST_BODY_BYTES=65536

# --- Outputs: Google Sheets projection (Phase 8) ------------------------------
# PostgreSQL is the system of record; the Sheet is a read-mostly projection.
# Share the spreadsheet with the service-account client_email as Editor.
# Key FILE path (secrets/ is git-ignored). Never paste key contents anywhere.
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/google/service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=
# The ONE tab the app writes (qualified leads + leads waiting for review, see lead_status).
# Synthetic demo data is never written to Google Sheets.
GOOGLE_SHEETS_WORKSHEET=Ai Leads
GOOGLE_SHEETS_TIMEOUT_SECONDS=30
GOOGLE_SHEETS_MAX_RETRIES=2
EXPORT_MAX_ROWS_PER_RUN=50
# Leads per tab; when a tab is full the next lead starts "Ai Leads 2", then "Ai Leads 3", ...
EXPORT_ROWS_PER_SHEET=500
# Live Sheet writes need ALLOW_SHEETS_WRITES=true (set per process) AND the CLI --live flag.
ALLOW_SHEETS_WRITES=false
